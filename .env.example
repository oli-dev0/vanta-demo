DJANGO_SETTINGS_MODULE=config.settings.demo
DJANGO_SECRET_KEY=replace-with-generated-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=demo.vanta.localhost,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://demo.vanta.localhost:8001
DATABASE_URL=sqlite:////tmp/vanta-demo-control.sqlite3
DATABASE_CONN_MAX_AGE=60
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_HTTPONLY=False
SESSION_COOKIE_SAMESITE=Lax
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
VANTA_DEMO_WORKSPACE_ROOT=/tmp/vanta-demo-workspaces
VANTA_DEMO_SEED_PATH=/tmp/vanta-demo-seed.sqlite3
VANTA_DEMO_SEED_VERSION=0.16.0-1
VANTA_DEMO_WORKSPACE_TTL_SECONDS=7200
VANTA_DEMO_MAX_WORKSPACES=100
VANTA_DEMO_START_LIMIT=5
VANTA_DEMO_START_WINDOW_SECONDS=600
VANTA_DEMO_HASH_SECRET=replace-with-random-hmac-secret
VANTA_DEMO_TRUSTED_IP_HEADER=HTTP_CF_CONNECTING_IP
